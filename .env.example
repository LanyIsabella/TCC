# CONFIGURAÇÕES DO OLLAMA

OLLAMA_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# API DA TOOL DE WEB SEARCH
LANGSEARCH_API_KEY=
LANGSEARCH_HOST=

# CONFIGURAÇÕES DO BANCO DE DADOS
DB_HOST=
DB_PORT=
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
BRONZE_SCHEMA=bronze
BRONZE_TABLE=documents
GLMOCR_CONFIG=config/glmocr.yaml
# package usa o pipeline oficial; direct_ollama evita o detector de layout local
# e envia uma imagem por página diretamente ao /api/generate do Ollama.
RAG_GLM_OCR_MODE=package
GLMOCR_DIRECT_MAX_TOKENS=16384
GLMOCR_DIRECT_RETRY_MAX_TOKENS=32768
GLMOCR_DIRECT_CONTEXT=16384
GLMOCR_DIRECT_TIMEOUT=120
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBED_URL=http://localhost:11434/api/embed
RAG_EVALUATION_MODEL=gemma4:e2b
RAG_EVALUATION_CONTEXT=16384
RAG_EVALUATION_MAX_TOKENS=2400
RAG_CONTEXT_TOKEN_LIMIT=8192
